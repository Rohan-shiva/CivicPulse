NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/civicpulse

JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=civicpulse

EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
DUPLICATE_SEARCH_RADIUS_METERS=75
DUPLICATE_AUTO_LINK_THRESHOLD=0.88
DUPLICATE_REVIEW_THRESHOLD=0.68

MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=10
MAX_AUDIO_DURATION_SECONDS=30
